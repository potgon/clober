{
  "name": "clober",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "pnpm --filter @clober/core dev",
    "latency-report": "tsx --conditions=development apps/core/scripts/latency-report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
